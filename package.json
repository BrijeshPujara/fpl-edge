{
  "name": "fpl-edge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "backtest": "tsx --tsconfig tsconfig.scripts.json scripts/backtest.ts",
    "db:types": "supabase gen types typescript --project-id ehfuwpslwzxsjjaatgng > lib/db/types.generated.ts.tmp && mv lib/db/types.generated.ts.tmp lib/db/types.generated.ts || (rm -f lib/db/types.generated.ts.tmp; exit 1)",
    "db:push": "supabase db push",
    "sync": "tsx --tsconfig tsconfig.scripts.json scripts/sync.ts",
    "pick": "tsx --tsconfig tsconfig.scripts.json scripts/pick-squad.ts",
    "ep:smoke": "tsx --tsconfig tsconfig.scripts.json scripts/ep-smoke.ts",
    "brief:check": "tsx --tsconfig tsconfig.scripts.json scripts/brief-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "glpk.js": "^5.0.0",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
