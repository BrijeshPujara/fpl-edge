# Supabase — create a project at https://supabase.com, then Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET. Bypasses row-level security, so it is the only key that can read or
# write these tables — every one of them has RLS enabled with no policies.
# Used only by cron route handlers and server components. It must never appear
# in a client component; lib/db/client.ts imports `server-only` to enforce that.
SUPABASE_SERVICE_ROLE_KEY=

# Your FPL team id — the number in your team URL, e.g. /entry/1234567/event/1
FPL_TEAM_ID=

# Comma-separated mini-league ids, from the league URL
FPL_LEAGUE_IDS=

# Optional. The engine is fully functional without it; the LLM only writes
# commentary on top of numbers the deterministic engine has already produced.
# If this is unset, the app renders the raw analysis and skips the brief.
ANTHROPIC_API_KEY=

# Shared secret for the cron route handlers. Generate with:
#   openssl rand -hex 32
CRON_SECRET=
